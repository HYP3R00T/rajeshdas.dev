---
import { ClientRouter } from "astro:transitions"
import { SITE } from "@data/config"
import CodeCopyButton from "@/components/core/CodeCopyButton.astro"
import HeadSEO from "@/components/core/HeadSEO.astro"
import PageContext from "@/components/core/PageContext.astro"
import SidebarShell from "@/components/core/SidebarShell.astro"
import type { BaseLayoutProps } from "@/lib/types"

const {
  title,
  description,
  image,
  imageAlt,
  contentType,
  pageLabel,
  breadcrumbs,
  publishedAt,
  pageAction,
  readingPage = false,
} = Astro.props as BaseLayoutProps
---

<html lang={SITE.lang ?? "en"}>
  <head>
    <HeadSEO title={title} description={description} image={image} imageAlt={imageAlt} contentType={contentType} />
    <ClientRouter />
  </head>

  <body class="relative flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only fixed top-4 left-4 z-100 bg-foreground-0 px-4 py-3 text-sm font-medium text-background-0 focus:not-sr-only"
    >
      Skip to content
    </a>
    <div class="site-shell">
      <SidebarShell />
      <div class="site-workspace" data-reading-page={readingPage || undefined}>
        <PageContext
          pageLabel={pageLabel || title?.split(" | ")[0]}
          breadcrumbs={breadcrumbs}
          publishedAt={publishedAt}
          pageAction={pageAction}
        />
        <main id="main-content" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>
    <CodeCopyButton />
  </body>
</html>

<script>
import "@/lib/tooltips"
</script>

<script is:inline>
;(() => {
  const applyTheme = () => {
    const savedTheme = localStorage.getItem("theme")
    const theme = savedTheme === "light" || savedTheme === "dark" || savedTheme === "system" ? savedTheme : "system"
    const isDark = theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)

    document.documentElement.classList.toggle("dark", isDark)
    document.documentElement.style.colorScheme = isDark ? "dark" : "light"
  }

  applyTheme()
  document.addEventListener("astro:after-swap", applyTheme)
})()
</script>
