---
import type { ImageMetadata, MarkdownHeading } from "astro"
import BaseLayout from "@/layouts/BaseLayout.astro"

interface Props {
  slug?: string
  title: string
  description: string
  kind: "Article" | "Note"
  pubDatetime: Date
  modDatetime?: Date
  tags?: string[]
  cover?: ImageMetadata
  coverAlt?: string
  ogImage?: ImageMetadata
  ogImageAlt?: string
  headings?: MarkdownHeading[]
}
const { slug, title, description, kind, pubDatetime, cover, coverAlt, ogImage, ogImageAlt, headings = [] } = Astro.props
const contents = headings.filter((heading) => heading.depth > 1 && heading.depth < 4)
const noteFileLabel = `${(slug || title)
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "_")
  .replace(/^_|_$/g, "")}.md`
const fileLabel =
  kind === "Article"
    ? slug ||
      title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "")
    : noteFileLabel
---

<BaseLayout
  title={title}
  pageLabel={fileLabel}
  publishedAt={pubDatetime}
  description={description}
  image={ogImage || cover}
  imageAlt={ogImageAlt || coverAlt || title}
  contentType="Article"
  readingPage
>
  <div class:list={["reading-page", { "has-contents": contents.length > 0 }]}>
    <article class="reading-column">
      <header class="reading-header">
        <h1>{title}</h1>
      </header>
      {contents.length > 0 && (
        <details class="reading-contents">
          <summary>Contents</summary>
          <nav aria-label="Article contents">
            {contents.map((heading) => (
              <a href={`#${heading.slug}`} data-reading-toc={heading.slug}>
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      )}
      <div class="prose reading-prose"><slot /></div>
    </article>
    {contents.length > 0 && (
      <aside class="reading-outline">
        <nav aria-label="Article contents">
          <ol>
            {contents.map((heading) => (
              <li class:list={{ "outline-nested": heading.depth === 3 }}>
                <a href={`#${heading.slug}`} data-reading-toc={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>
<script>
const setupReading = () => {
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-reading-toc]"))
  const controller = new AbortController()
  links.forEach((link) => {
    link.addEventListener(
      "click",
      (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        const heading = document.getElementById(link.dataset.readingToc || "")
        if (!heading) return
        event.preventDefault()
        history.pushState(null, "", link.hash)
        heading.setAttribute("tabindex", "-1")
        heading.focus({ preventScroll: true })
        const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth"
        const workspace = heading.closest<HTMLElement>(".site-workspace")
        if (workspace && window.matchMedia("(min-width: 1024px)").matches) {
          const headerHeight = workspace.querySelector(".workspace-bar")?.getBoundingClientRect().height || 0
          workspace.scrollTo({
            top:
              workspace.scrollTop +
              heading.getBoundingClientRect().top -
              workspace.getBoundingClientRect().top -
              headerHeight -
              16,
            behavior,
          })
        } else {
          window.scrollTo({ top: window.scrollY + heading.getBoundingClientRect().top - 96, behavior })
        }
      },
      { signal: controller.signal },
    )
  })
  const observer = new IntersectionObserver(
    (entries) => {
      const heading = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
      if (!heading) return
      links.forEach((link) => {
        if (link.dataset.readingToc === heading.target.id) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      })
    },
    { rootMargin: "-15% 0px -60% 0px" },
  )
  const headings = new Set(links.map((link) => document.getElementById(link.dataset.readingToc || "")))
  headings.forEach((heading) => {
    if (heading) observer.observe(heading)
  })
  document.addEventListener(
    "astro:before-swap",
    () => {
      observer.disconnect()
      controller.abort()
    },
    { once: true },
  )
}
document.addEventListener("astro:page-load", setupReading)
</script>
