<style>
:global(.code-block) {
  overflow: hidden;
  margin-block: 2rem;
  border: 1px solid var(--border);
  border-radius: 0;
  background: var(--background-1);
  color: var(--foreground-1);
  --code-foreground: var(--foreground-1);
  --code-background: var(--background-1);
  --code-token-keyword: var(--purple-0);
  --code-token-function: var(--accent-1);
  --code-token-type: var(--yellow-0);
  --code-token-property: var(--cyan-0);
  --code-token-string: var(--green-0);
  --code-token-string-expression: var(--green-0);
  --code-token-comment: var(--foreground-3);
  --code-token-constant: var(--orange-0);
  --code-token-parameter: var(--foreground-1);
  --code-token-punctuation: var(--foreground-2);
  --code-token-link: var(--accent-1);
  --code-token-inserted: var(--green-0);
  --code-token-deleted: var(--red-0);
  --code-token-changed: var(--yellow-0);
  --code-ansi-black: var(--foreground-3);
  --code-ansi-white: var(--foreground-1);
  --code-ansi-red: var(--red-0);
  --code-ansi-green: var(--green-0);
  --code-ansi-yellow: var(--yellow-0);
  --code-ansi-blue: var(--blue-0);
  --code-ansi-magenta: var(--purple-0);
  --code-ansi-cyan: var(--cyan-0);
  --code-ansi-bright-black: var(--foreground-3);
  --code-ansi-bright-white: var(--foreground-0);
  --code-ansi-bright-red: var(--red-0);
  --code-ansi-bright-green: var(--green-0);
  --code-ansi-bright-yellow: var(--yellow-0);
  --code-ansi-bright-blue: var(--blue-0);
  --code-ansi-bright-magenta: var(--purple-0);
  --code-ansi-bright-cyan: var(--cyan-0);
  --code-ansi-black-dim: color-mix(in srgb, var(--code-ansi-black) 65%, transparent);
  --code-ansi-white-dim: color-mix(in srgb, var(--code-ansi-white) 65%, transparent);
  --code-ansi-red-dim: color-mix(in srgb, var(--code-ansi-red) 65%, transparent);
  --code-ansi-green-dim: color-mix(in srgb, var(--code-ansi-green) 65%, transparent);
  --code-ansi-yellow-dim: color-mix(in srgb, var(--code-ansi-yellow) 65%, transparent);
  --code-ansi-blue-dim: color-mix(in srgb, var(--code-ansi-blue) 65%, transparent);
  --code-ansi-magenta-dim: color-mix(in srgb, var(--code-ansi-magenta) 65%, transparent);
  --code-ansi-cyan-dim: color-mix(in srgb, var(--code-ansi-cyan) 65%, transparent);
  --code-ansi-bright-black-dim: color-mix(in srgb, var(--code-ansi-bright-black) 65%, transparent);
  --code-ansi-bright-white-dim: color-mix(in srgb, var(--code-ansi-bright-white) 65%, transparent);
  --code-ansi-bright-red-dim: color-mix(in srgb, var(--code-ansi-bright-red) 65%, transparent);
  --code-ansi-bright-green-dim: color-mix(in srgb, var(--code-ansi-bright-green) 65%, transparent);
  --code-ansi-bright-yellow-dim: color-mix(in srgb, var(--code-ansi-bright-yellow) 65%, transparent);
  --code-ansi-bright-blue-dim: color-mix(in srgb, var(--code-ansi-bright-blue) 65%, transparent);
  --code-ansi-bright-magenta-dim: color-mix(in srgb, var(--code-ansi-bright-magenta) 65%, transparent);
  --code-ansi-bright-cyan-dim: color-mix(in srgb, var(--code-ansi-bright-cyan) 65%, transparent);
}

:global(.code-block__header) {
  display: flex;
  height: 2.5rem;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-bottom: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.08em;
}

:global(.code-block__meta) {
  display: flex;
  min-width: 0;
  align-self: stretch;
  align-items: stretch;
}

:global(.code-block__language) {
  flex: none;
  display: flex;
  align-items: center;
  padding-inline: 1rem;
  border-right: 1px solid var(--border);
  color: var(--foreground-3);
  text-transform: uppercase;
}

:global(.code-block__filename) {
  min-width: 0;
  padding-inline: 1rem;
  line-height: 2.5rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

:global(.code-block__copy) {
  align-self: stretch;
  flex: none;
  border: 0;
  border-left: 1px solid var(--border);
  padding-inline: 0.875rem;
  background: transparent;
  color: var(--foreground-2);
  font: inherit;
  letter-spacing: inherit;
  cursor: pointer;
  transition:
    background-color 150ms ease,
    opacity 150ms ease;
}

:global(.code-block__copy:hover) {
  background: var(--background-2);
  opacity: 1;
}

:global(.code-block__copy:focus-visible) {
  outline: 2px solid var(--accent-1);
  outline-offset: -3px;
  opacity: 1;
}

:global(.code-block__copy[data-copied="true"]) {
  opacity: 1;
}

:global(.prose .code-block pre) {
  margin: 0;
  border: 0;
  border-radius: 0;
  padding: 1.125rem 0;
  background: transparent !important;
}

:global(.prose .code-block pre code) {
  display: grid;
  min-width: max-content;
}
:global(.code-block [data-line]) {
  padding-inline: 1.25rem;
}
:global(.code-block [data-highlighted-line]) {
  background: color-mix(in oklch, var(--accent-1) 7%, transparent);
  box-shadow: inset 2px 0 color-mix(in oklch, var(--accent-1) 65%, transparent);
}

/* Keep the scroll gutter reserved so revealing it never shifts the code. */
:global(.code-block pre::-webkit-scrollbar-thumb) {
  background: transparent;
}
:global(.code-block:hover pre::-webkit-scrollbar-thumb),
:global(.code-block:focus-within pre::-webkit-scrollbar-thumb) {
  background: var(--foreground-3);
}
:global(.code-block pre::-webkit-scrollbar-thumb:hover) {
  background: var(--foreground-2);
}
@supports not selector(::-webkit-scrollbar) {
  :global(.code-block pre) {
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }
  :global(.code-block:hover pre),
  :global(.code-block:focus-within pre) {
    scrollbar-color: var(--foreground-3) transparent;
  }
}
</style>

<script>
function initCodeCopyButtons() {
  document.querySelectorAll("[data-code-copy]").forEach((copyButton) => {
    if (!(copyButton instanceof HTMLButtonElement) || copyButton.dataset.initialized === "true") return

    copyButton.dataset.initialized = "true"
    copyButton.addEventListener("click", async () => {
      const code = copyButton.closest("[data-code-block]")?.querySelector("code")
      if (!code || !navigator.clipboard) return

      await navigator.clipboard.writeText(code.textContent ?? "")
      copyButton.textContent = "Copied"
      copyButton.dataset.copied = "true"

      setTimeout(() => {
        copyButton.textContent = "Copy"
        delete copyButton.dataset.copied
      }, 1800)
    })
  })
}

initCodeCopyButtons()
document.addEventListener("astro:page-load", initCodeCopyButtons)
</script>
