---
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"header"> {
  eyebrow: string
  title: string
  titleId: string
  description: string
  headingLevel?: 1 | 2
  transitionName?: string
}

const {
  eyebrow,
  title,
  titleId,
  description,
  headingLevel = 2,
  transitionName,
  class: className,
  ...attributes
} = Astro.props as Props
const Heading = headingLevel === 1 ? "h1" : "h2"
const hasAction = Astro.slots.has("action")
---

<header
  {...attributes}
  class:list={["site-section-heading grid gap-4 px-5 py-10 md:px-10 md:py-12 lg:px-15", className]}
>
  <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-accent-1 uppercase">
    {eyebrow}
  </p>
  {hasAction && (
    <div class="justify-self-start ">
      <slot name="action" />
    </div>
  )}
  <Heading
    id={titleId}
    transition:name={transitionName}
    class="max-w-2xl text-balance font-display text-4xl leading-[1.05] font-medium tracking-[-0.03em] text-foreground-0 md:text-5xl"
  >
    {title}
  </Heading>

  <p class="max-w-xl text-base leading-7 text-foreground-2 md:text-lg md:leading-8">
    {description}
  </p>
</header>
