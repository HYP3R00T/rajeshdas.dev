---
import { Icon } from "astro-icon/components"

interface Props {
  href: string
}
const { href } = Astro.props
---

<div class="article-source-actions">
  <button
    type="button"
    class="article-copy"
    data-article-copy={href}
    aria-label="Copy article as Markdown"
    title="Copy article as Markdown"
  >
    <Icon name="copy" class="copy-idle" aria-hidden="true" />
    <Icon name="check" class="copy-success" aria-hidden="true" />
  </button>
  <a href={href} target="_blank" rel="noopener noreferrer" title="View article source">Markdown</a>
  <span class="article-copy-status" role="status" aria-live="polite"></span>
</div>

<style>
.article-source-actions {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 0.75rem;
  color: var(--foreground-3);
  font: 0.7rem var(--font-mono);
  text-transform: uppercase;
}
.article-copy {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  background: transparent;
  border: 0;
  color: inherit;
}
.article-copy svg {
  width: 1rem;
  height: 1rem;
}
.article-copy:hover,
.article-source-actions a:hover {
  color: var(--foreground-0);
}
.article-copy:focus-visible,
.article-source-actions a:focus-visible {
  outline: 1px solid var(--foreground-2);
  outline-offset: 3px;
}
.copy-success,
.article-copy[data-copied] .copy-idle {
  display: none;
}
.article-copy[data-copied] .copy-success {
  display: block;
}
.article-copy-status {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
}
.article-copy-status[data-error] {
  position: static;
  width: auto;
  height: auto;
  clip-path: none;
  color: var(--foreground-1);
  text-transform: none;
}
</style>

<script>
const initArticleCopy = () => {
  document.querySelectorAll<HTMLButtonElement>("[data-article-copy]").forEach((button) => {
    if (button.dataset.initialized) return
    button.dataset.initialized = "true"
    button.addEventListener("click", async () => {
      const status = button.parentElement?.querySelector<HTMLElement>(".article-copy-status")
      if (!status) return
      button.disabled = true
      button.setAttribute("aria-busy", "true")
      delete status.dataset.error
      status.textContent = "Copying article…"
      try {
        const response = await fetch(button.dataset.articleCopy ?? "")
        if (!response.ok || !/text\/(plain|markdown)/.test(response.headers.get("content-type") ?? "")) {
          throw new Error("Article source unavailable")
        }
        await navigator.clipboard.writeText(await response.text())
        button.dataset.copied = "true"
        status.textContent = "Article copied as Markdown."
        setTimeout(() => {
          delete button.dataset.copied
        }, 2000)
      } catch {
        status.dataset.error = "true"
        status.textContent = "Copy unavailable. Open Markdown to copy the source."
      } finally {
        button.disabled = false
        button.removeAttribute("aria-busy")
      }
    })
  })
}
initArticleCopy()
document.addEventListener("astro:page-load", initArticleCopy)
</script>
