---
import { Icon } from "astro-icon/components"
import type { PostCardProps } from "@/lib/types"
import { formatDateUppercase } from "@/lib/utils"

interface Props extends PostCardProps {}
const { post } = Astro.props
---

<a href={`/post/${post.id}/`} class="archive-entry" data-post-card>
  <div class="archive-entry-heading">
    <Icon name="file" is:inline class="archive-entry-icon" aria-hidden="true" />
    <h2>{post.data.title}</h2>
    <Icon name="arrow-right" is:inline class="archive-entry-arrow" aria-hidden="true" />
  </div>
  <p>{post.data.description}</p>
  <div class="archive-entry-meta">
    <time datetime={post.data.pubDatetime.toISOString()}>{formatDateUppercase(post.data.pubDatetime)}</time>
    <span>{post.data.category}</span>
  </div>
</a>
