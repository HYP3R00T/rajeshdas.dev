---
import { getCollection } from "astro:content"
import { Icon } from "astro-icon/components"
import PostCard from "@/components/post/PostCard.astro"

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 3)
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 100) - (b.data.order ?? 100),
)
---

<div class="home-panels">
  <section class="home-panel home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="quiet-label">Python &amp; DevOps Automation Engineer</p>
      <h1 id="home-title">Less manual work.<br><span>More room to build.</span></h1>
      <p class="home-hero-description">
        I’m Rajesh. I build Python automation, developer tools, and infrastructure workflows that turn repetitive work
        into something you can run, understand, and trust.
      </p>
      <div class="home-hero-actions">
        <a href="https://hyperoot.dev/" target="_blank" rel="noopener noreferrer" class="home-primary-action"
          >Explore my projects</a
        >
        <a href="/contact/" class="home-secondary-action">Let’s talk</a>
      </div>
    </div>
    <div class="home-project-index">
      <h2 class="quiet-label">Things I’ve built</h2>
      <ol>
        {projects.map((project, index) => (
          <li>
            <a href={project.data.website || project.data.sourceRepo} target="_blank" rel="noopener noreferrer">
              <span class="home-project-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
              </div>
              <Icon name="arrow-up-right" is:inline aria-hidden="true" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-panel home-journal" aria-labelledby="home-writing-title">
    <div class="home-panel-caption">
      <div>
        <p class="quiet-label">Notes from the work</p>
        <h2 id="home-writing-title">What I’m figuring out.</h2>
      </div>
      <a href="/post/">[All writing]</a>
    </div>
    <ul class="archive-grid home-journal-grid">
      {posts.map((post) => (
        <li data-archive-entry>
          <PostCard post={post} headingLevel={3} />
        </li>
      ))}
    </ul>
  </section>
</div>
