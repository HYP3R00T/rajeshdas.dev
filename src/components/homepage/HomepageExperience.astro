---
import { getCollection } from "astro:content"
import { homepageIntro } from "@data/homepage"

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 3)
---

<div class="personal-home">
  <section class="home-introduction" aria-labelledby="home-title">
    <p class="quiet-label">Personal website</p>
    <h1 id="home-title">Rajesh Das<span>.</span></h1>
    <p class="home-role">{homepageIntro.role}</p>
    <p class="home-description">{homepageIntro.description}</p>
    <a href="/contact/" class="text-link">Get in touch →</a>
  </section>
  <section class="home-writing" aria-labelledby="writing-title">
    <div class="home-section-label">
      <h2 id="writing-title">Writing</h2>
      <a href="/post/">All articles →</a>
    </div>
    {posts.map((post) => (
      <a class="home-entry" href={`/post/${post.id}/`}>
        <h3>
          {post.data.title}
          <span aria-hidden="true">→</span>
        </h3>
        <p>{post.data.description}</p>
      </a>
    ))}
  </section>
  <section class="home-connection" aria-labelledby="projects-title">
    <h2 id="projects-title">Things I build</h2>
    <p>My projects live at <a href="https://hyperoot.dev/" class="text-link">hyperoot.dev ↗</a>.</p>
    <p>For work, collaboration, or a conversation, <a href="/contact/" class="text-link">get in touch →</a></p>
  </section>
</div>
