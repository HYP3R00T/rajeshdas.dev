---
import { getImage } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import SectionHeader from "@/components/core/SectionHeader.astro"
import SiteSection from "@/components/core/SiteSection.astro"
import LatestSignalSwitcher from "@/components/homepage/LatestSignalSwitcher"

interface Props {
  latestPost: CollectionEntry<"posts">
}

const { latestPost } = Astro.props as Props
const articleImageWidths = [720, 1080, 1440, 1920] as const
const articleImages = await Promise.all(
  articleImageWidths.map((width) => getImage({ src: latestPost.data.cover, width, format: "webp", quality: "max" })),
)
const articleImageSrcSet = articleImages.map((image, index) => `${image.src} ${articleImageWidths[index]}w`).join(", ")
const articleImageSrc = articleImages.at(-1)?.src ?? articleImages[0].src
const latestVideo = {
  id: "v_rcTD2O-aU",
  title: "Latest video from Hyperoot",
  channelUrl: "https://www.youtube.com/@hyperoot",
} as const
const videoThumbnail = `https://i.ytimg.com/vi/${latestVideo.id}/maxresdefault.jpg`
const videoUrl = `https://www.youtube.com/embed/${latestVideo.id}?autoplay=1&rel=0&modestbranding=1`
---

<SiteSection id="writing" data-home-section aria-labelledby="signal-title">
  <SectionHeader
    eyebrow="Open notebook"
    title="The thinking stays visible."
    titleId="signal-title"
    description="Articles and videos turn implementation lessons into reusable mental models, practical patterns, and clearer engineering decisions."
  />

  <LatestSignalSwitcher
    client:load
    articleTitle={latestPost.data.title}
    articleDescription={latestPost.data.description}
    articleHref={`/post/${latestPost.id}`}
    articleImageSrc={articleImageSrc}
    articleImageSrcSet={articleImageSrcSet}
    articleImageAlt={latestPost.data.coverAlt || latestPost.data.title}
    videoTitle={latestVideo.title}
    videoThumbnail={videoThumbnail}
    videoUrl={videoUrl}
    channelUrl={latestVideo.channelUrl}
  />
</SiteSection>
